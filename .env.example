# Copy to .env.local (never committed) and adjust. Restart `npm run dev` after changes.

# --- Safety -----------------------------------------------------------------
# Writes (create ticket, reply, update) are DRY RUN unless this is true.
# Even when true, every write shows the exact request and needs a confirm click.
SUPPORT_LIVE_MODE=false

# Problem-type suggestions use the classifyProblems preview API (2025-06-01-preview).
SUPPORT_CLASSIFY_ENABLED=true

# --- Authentication ---------------------------------------------------------
# cli               -> your `az login` session (default)
# service-principal -> AZURE_TENANT_ID + AZURE_CLIENT_ID + secret or certificate
# user              -> browser sign-in with Entra ID (needs an app registration)
AUTH_MODE=cli

# Service principal (AUTH_MODE=service-principal)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_CLIENT_CERTIFICATE_PATH=/absolute/path/to/cert.pem

# User sign-in (AUTH_MODE=user) — see docs/SETUP.md
# AZURE_AD_TENANT_ID=organizations
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# APP_BASE_URL=http://localhost:3000
